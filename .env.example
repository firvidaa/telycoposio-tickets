# =====================================================================
# Plantilla de variables de entorno para Telycoposio Tickets
# Copia este archivo a `.env` y rellena los valores reales.
# El fichero `.env` NO debe subirse al repositorio (ya esta en .gitignore).
# =====================================================================

# === Aplicacion ===
APP_ENV=development
# Genera una clave nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=cambiar-por-clave-aleatoria-de-al-menos-32-bytes
APP_HOST=0.0.0.0
APP_PORT=8000
# URL base para construir enlaces en notificaciones internas.
APP_BASE_URL=http://localhost:8000

# === Anthropic (categorizacion con Claude) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Email (IMAP + SMTP con App Password de Google) ===
# Las 4 variables EMAIL_* son obligatorias para arrancar la app.
EMAIL_ADDRESS=soportetelycoposio@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# === Worker de polling de email (Paso 8) ===
# Por defecto OFF: ponlo a `true` para arrancar el job que lee IMAP,
# crea tickets y manda confirmaciones. Si esta `false`, la app web
# funciona pero no procesa correo entrante.
WORKER_ENABLED=false
EMAIL_POLL_INTERVAL_SECONDS=60

# === Notificacion interna ===
INTERNAL_NOTIFICATION_EMAIL=soporte@telycoposio.com

# === Google Sheets (Paso 9) ===
# Por defecto OFF: ponlo a `true` para arrancar el job que vuelca los
# tickets de SQLite a la hoja. Si GSHEETS_ENABLED=true, son obligatorios
# GSHEETS_SPREADSHEET_ID y GSHEETS_CREDENTIALS_PATH (el arranque falla
# con mensaje accionable si faltan).
GSHEETS_ENABLED=false
GSHEETS_SPREADSHEET_ID=pegar-aqui-el-id-de-la-hoja
GSHEETS_CREDENTIALS_PATH=./secrets/gsheets_service_account.json
GSHEETS_WORKSHEET_NAME=Tickets
GSHEETS_SYNC_INTERVAL_SECONDS=300

# === Base de datos local (SQLite) ===
SQLITE_PATH=./data/app.db

# === Configuracion de tickets ===
TICKET_PREFIX=TLY
